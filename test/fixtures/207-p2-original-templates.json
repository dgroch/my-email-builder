{
  "sections/body-copy-plain": "<!-- COMPONENT: sections/body-copy-plain | BODY COPY — NO ILLUSTRATION, HTML-SAFE\nTOKENS:\n  {{SUPER_LABEL}}  — optional small uppercase label above headline. Leave \"\" to omit.\n  {{HEADLINE}}     — Lust font — SENTENCE CASE (e.g. \"The one that feels like home.\") — optional; leave \"\" for copy alone.\n  {{BODY_P1}}      — first paragraph\n  {{BODY_P2}}      — second paragraph (optional — leave blank if not needed; no empty row is left behind)\nRULES:\n  - No illustration — safe to render as inline HTML in email clients\n  - Use this variant when no accent illustration is desired\n  - Background is white — do not change\n-->\n<tr><td>\n<table class=\"f600\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-top:1px solid #e8e2da;\">\n  <tr>\n    <td class=\"sp\" align=\"center\" style=\"padding:44px 64px;background:#ffffff;text-align:center;\">\n      {{#SUPER_LABEL}}<p style=\"font-family:'NeuzeitGro','Gill Sans','Gill Sans MT',Calibri,sans-serif;font-weight:700;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:#aaaaaa;margin:0 0 14px 0;\">{{SUPER_LABEL}}</p>{{/SUPER_LABEL}}\n      {{#HEADLINE}}<h2 class=\"sh\" style=\"font-family:'Lust',Georgia,'Times New Roman',serif;font-weight:normal;font-style:normal;font-size:28px;color:#000000;line-height:1.2;margin:0 0 20px 0;\">{{HEADLINE}}</h2>{{/HEADLINE}}\n      <!-- Fixed-width table, not a max-width cap: Word ignores max-width, which ran the\n           measure from 440px out to the full 472px of available width. -->\n      <table width=\"440\" class=\"fm\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:440px;margin:0 auto;\">\n        <tr>\n          <td style=\"font-family:'NeuzeitGro','Gill Sans','Gill Sans MT',Calibri,sans-serif;font-weight:300;font-size:14px;color:#444444;line-height:1.85;text-align:center;padding:0;\">{{BODY_P1}}</td>\n        </tr>\n        {{#BODY_P2}}<tr>\n          <td style=\"font-family:'NeuzeitGro','Gill Sans','Gill Sans MT',Calibri,sans-serif;font-weight:300;font-size:14px;color:#444444;line-height:1.85;text-align:center;padding:14px 0 0 0;\">{{BODY_P2}}</td>\n        </tr>{{/BODY_P2}}\n      </table>\n    </td>\n  </tr>\n</table>\n</td></tr>\n",
  "sections/full-width-image": "<!-- COMPONENT: sections/full-width-image | FULL-WIDTH IMAGE (LIVE HTML, OPTIONAL LINK)\nTOKENS:\n  {{IMAGE_URL}}  — full-width image URL (600px wide; any height — the image's natural ratio is kept). Klaviyo/R2 hosted.\n  {{ALT_TEXT}}   — alt text describing the image (required for accessibility).\n  {{LINK_URL}}   — optional href wrapping the image. Leave \"\" for no link.\nRULES:\n  - LIVE HTML (html_only) — NOT sliced — so the image keeps its own click-through link and an\n    animated GIF keeps animating. Listed in assembly.html_only_components.\n  - Full 600px content width, edge to edge. Any aspect ratio: the image's natural height is kept.\n  - No text, no button — a single full-width image. For a fixed 4:5 photo hero use\n    heroes/hero-image-only; for a short 180px lifestyle pause use dividers/divider-image.\n-->\n<tr><td style=\"padding:0;line-height:0;font-size:0;\">\n{{#LINK_URL}}<a href=\"{{LINK_URL}}\" style=\"display:block;line-height:0;text-decoration:none;\" target=\"_blank\">{{/LINK_URL}}\n<img class=\"fimg\" src=\"{{IMAGE_URL}}\" alt=\"{{ALT_TEXT}}\" width=\"600\" border=\"0\" style=\"display:block;width:100%;max-width:100%;max-width:600px;height:auto;\">\n{{#LINK_URL}}</a>{{/LINK_URL}}\n</td></tr>\n"
}
